{
  "id": "ne_commit",
  "name": "ne-agent · 提交（先测试+门禁）",
  "description": "测试 → 门禁 → 展示变更 → 人工确认提交说明 → 本地提交（不推送）。任一前置失败即中止。",
  "iconName": "GitCommit",
  "category": "ne-agent",
  "isBuiltin": false,
  "trigger": { "type": "manual", "slashCommand": "/wf ne_commit" },
  "defaultVariables": {
    "PROJECT_DIR": "/workspace/小说系统",
    "COMMIT_MESSAGE": "chore: update"
  },
  "nodes": [
    {
      "id": "start",
      "type": "TRIGGER",
      "title": "开始提交",
      "description": "变量：PROJECT_DIR / COMMIT_MESSAGE",
      "config": {},
      "canvasX": 40.0,
      "canvasY": 160.0
    },
    {
      "id": "gate",
      "type": "BASH_COMMAND",
      "title": "架构门禁",
      "config": {
        "command": "cd ${PROJECT_DIR} && python3 scripts/arch_check.py"
      },
      "canvasX": 260.0,
      "canvasY": 160.0,
      "timeoutSeconds": 300,
      "failurePolicy": "ABORT"
    },
    {
      "id": "test",
      "type": "BASH_COMMAND",
      "title": "全量测试",
      "config": {
        "command": "export PATH=/opt/taixu/toolchains/rust/bin:$PATH; cd ${PROJECT_DIR}; cargo test --workspace > /tmp/ne-commit-test.log 2>&1; rc=$?; tail -8 /tmp/ne-commit-test.log; test $rc -eq 0"
      },
      "canvasX": 480.0,
      "canvasY": 160.0,
      "timeoutSeconds": 1800,
      "failurePolicy": "ABORT"
    },
    {
      "id": "diff",
      "type": "BASH_COMMAND",
      "title": "展示变更",
      "config": {
        "command": "cd ${PROJECT_DIR} && git status --short && echo '--- 统计 ---' && git diff --stat && git diff --cached --stat"
      },
      "canvasX": 700.0,
      "canvasY": 160.0,
      "failurePolicy": "CONTINUE"
    },
    {
      "id": "approve",
      "type": "HUMAN_APPROVAL",
      "title": "确认提交说明",
      "description": "审阅上方变更与测试结果。确认后将以 COMMIT_MESSAGE 创建本地提交（不推送）。",
      "config": { "requestedVariables": "COMMIT_MESSAGE" },
      "canvasX": 920.0,
      "canvasY": 160.0
    },
    {
      "id": "commit",
      "type": "BASH_COMMAND",
      "title": "创建本地提交",
      "config": {
        "command": "cd ${PROJECT_DIR} && git add -A && git commit -m ${COMMIT_MESSAGE} && echo '--- 提交结果 ---' && git log --oneline -1"
      },
      "canvasX": 1140.0,
      "canvasY": 160.0,
      "timeoutSeconds": 300,
      "failurePolicy": "ABORT"
    },
    {
      "id": "done",
      "type": "TERMINAL_OUTPUT",
      "title": "提交完成",
      "config": {},
      "canvasX": 1360.0,
      "canvasY": 160.0
    }
  ],
  "edges": [
    { "id": "e0", "fromNodeId": "start", "fromPort": "success", "toNodeId": "gate", "toPort": "input" },
    { "id": "e1", "fromNodeId": "gate", "fromPort": "success", "toNodeId": "test", "toPort": "input" },
    { "id": "e2", "fromNodeId": "test", "fromPort": "success", "toNodeId": "diff", "toPort": "input" },
    { "id": "e3", "fromNodeId": "diff", "fromPort": "success", "toNodeId": "approve", "toPort": "input" },
    { "id": "e4", "fromNodeId": "approve", "fromPort": "success", "toNodeId": "commit", "toPort": "input" },
    { "id": "e5", "fromNodeId": "commit", "fromPort": "success", "toNodeId": "done", "toPort": "input" }
  ]
}
