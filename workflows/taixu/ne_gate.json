{
  "id": "ne_gate",
  "name": "ne-agent · 门禁",
  "description": "架构门禁（单文件行数上限等）。薄壳：只调 workflows/run.sh ne_gate，真正逻辑在 workflows/scripts/ne_gate.sh。",
  "iconName": "ShieldCheck",
  "category": "ne-agent",
  "isBuiltin": false,
  "defaultVariables": {
    "PROJECT_DIR": "/workspace/小说系统"
  },
  "trigger": { "type": "manual", "slashCommand": "/wf ne_gate" },
  "nodes": [
    {
      "id": "start",
      "type": "TRIGGER",
      "title": "开始门禁",
      "config": {},
      "timeoutSeconds": 30,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 0.0,
      "description": ""
    },
    {
      "id": "run",
      "type": "BASH_COMMAND",
      "title": "run.sh ne_gate",
      "config": {
        "command": "cd ${PROJECT_DIR} && bash workflows/run.sh ne_gate"
      },
      "timeoutSeconds": 300,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 120.0,
      "description": "唯一真源：workflows/scripts/ne_gate.sh"
    },
    {
      "id": "done",
      "type": "TERMINAL_OUTPUT",
      "title": "门禁完成",
      "config": {},
      "timeoutSeconds": 30,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 240.0,
      "description": ""
    }
  ],
  "edges": [
    { "id": "e1", "fromNodeId": "start", "fromPort": "success", "toNodeId": "run", "toPort": "input" },
    { "id": "e2", "fromNodeId": "run", "fromPort": "success", "toNodeId": "done", "toPort": "input" }
  ]
}
