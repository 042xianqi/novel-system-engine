{
  "id": "ne_test",
  "name": "ne-agent · 测试",
  "description": "全 workspace 测试 + 汇总。薄壳：只调 workflows/run.sh ne_test，真正逻辑在 workflows/scripts/ne_test.sh。",
  "iconName": "TestTube",
  "category": "ne-agent",
  "isBuiltin": false,
  "defaultVariables": {
    "PROJECT_DIR": "/workspace/小说系统"
  },
  "trigger": { "type": "manual", "slashCommand": "/wf ne_test" },
  "nodes": [
    {
      "id": "start",
      "type": "TRIGGER",
      "title": "开始测试",
      "config": {},
      "timeoutSeconds": 30,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 0.0,
      "description": ""
    },
    {
      "id": "run",
      "type": "BASH_COMMAND",
      "title": "run.sh ne_test",
      "config": {
        "command": "cd ${PROJECT_DIR} && bash workflows/run.sh ne_test"
      },
      "timeoutSeconds": 900,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 120.0,
      "description": "唯一真源：workflows/scripts/ne_test.sh"
    },
    {
      "id": "done",
      "type": "TERMINAL_OUTPUT",
      "title": "测试完成",
      "config": {},
      "timeoutSeconds": 30,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 240.0,
      "description": ""
    }
  ],
  "edges": [
    { "id": "e1", "fromNodeId": "start", "fromPort": "success", "toNodeId": "run", "toPort": "input" },
    { "id": "e2", "fromNodeId": "run", "fromPort": "success", "toNodeId": "done", "toPort": "input" }
  ]
}
