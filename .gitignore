target/
*.bak

# ne-agent vault 产物（每个项目一个自包含库，不入版本库）
.neagent/
agent.db
agent.db-wal
agent.db-shm

# 运行时覆盖层（外部热调，不入版本库）
agent_override/

# 编辑器/系统
.DS_Store
*.swp

# 工作流运行产物（日志/状态）
.wf/
workflows/_backup/
__pycache__/

# ── 前端工程（frontend/）────────────────────────────────
# node_modules 不入库（57MB，且 npm install 可完全重建）
frontend/node_modules/
# dist 是构建产物：**不入库**，但部署机上要跑一次 npm run build
# （若将来需要「开箱即用」，改成入库 dist 并删掉这一行即可）
frontend/dist/
# 本地开发缓存
frontend/.vite/
frontend/*.local
npm-debug.log*

