target/
*.bak

# ne-agent vault 产物（每个项目一个自包含库，不入版本库）
.neagent/
agent.db
agent.db-wal
agent.db-shm

# 运行时覆盖层（外部热调，不入版本库）
agent_override/

# 编辑器/系统
.DS_Store
*.swp

# 工作流运行产物（日志/状态）
.wf/
workflows/_backup/
__pycache__/

# ── 前端工程（frontend/）────────────────────────────────
# node_modules 不入库（57MB，且 npm install 可完全重建）
frontend/node_modules/
# dist 是构建产物：**不入库**，但部署机上要跑一次 npm run build
# （若将来需要「开箱即用」，改成入库 dist 并删掉这一行即可）
frontend/dist/
# 本地开发缓存
frontend/.vite/
frontend/*.local
npm-debug.log*


# ══════════════════════════════════════════════════════════════
# 2026-10-18 开源前清理：把「运行产物」与「本地环境残留」赶出版本库
# 理由：这些不是源码，且含本地绝对路径 / 真实业务数据 / 审计快照，
#       公开仓库里出现既不专业也有泄露风险。
# ══════════════════════════════════════════════════════════════
.ci/
.skill_run/
nohup.out
*.log
*.stdout
*.err
*.out

# 第三方项目逆向/对照笔记（涉及他人代码库，不公开发布）
docs/ref_taixu_harness_notes.md
docs/ref_omp_notes.md
# 太墟 App 工作流安装器（操作第三方 App 内部 Room DB）
workflows/install_taixu_workflows.py

# ══════════════════════════════════════════════════════════════
# 2026-10-19 仓库卫生：剥离数据库、小说资料卡与本地备份
# ══════════════════════════════════════════════════════════════
# 数据库（含真实业务数据/角色状态，绝不入库）
novel.db
novel.db-wal
novel.db-shm
*.sqlite
*.sqlite3
# 资料库卡片正典数据（02_资料库 下全部 .md 为小说资产，不是源码）
02_资料库/
**/02_资料库/
# 冷备份目录（本地快照，不入版本库）
09_冷备份/
# 敏感凭据（保留模板，禁止提交实际值）
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
secrets/
.netrc
.git-credentials
# 临时/缓存
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
.tmp/
# 允许入库前端打包产物（开箱即用）
!frontend/dist/
!frontend/dist/**

# 2026-10-19: OAuth App 缺 workflow scope，GitHub 拒绝推送 .github/workflows/*
