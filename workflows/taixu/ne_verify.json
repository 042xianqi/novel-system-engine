{
  "id": "ne_verify",
  "name": "ne-agent · 全量验证",
  "description": "一条龙：架构门禁 → 全量测试 → release 编译 → 产物与依赖体检。最常用的一条。",
  "iconName": "Rocket",
  "category": "ne-agent",
  "isBuiltin": false,
  "trigger": { "type": "manual", "slashCommand": "/wf ne_verify" },
  "defaultVariables": {
    "PROJECT_DIR": "/workspace/小说系统"
  },
  "nodes": [
    {
      "id": "start",
      "type": "TRIGGER",
      "title": "开始验证",
      "config": {},
      "canvasX": 40.0,
      "canvasY": 200.0
    },
    {
      "id": "gate",
      "type": "BASH_COMMAND",
      "title": "① 架构门禁",
      "config": {
        "command": "cd ${PROJECT_DIR} && python3 scripts/arch_check.py"
      },
      "canvasX": 260.0,
      "canvasY": 120.0,
      "timeoutSeconds": 300,
      "failurePolicy": "ABORT"
    },
    {
      "id": "test",
      "type": "BASH_COMMAND",
      "title": "② 全量测试",
      "config": {
        "command": "export PATH=/opt/taixu/toolchains/rust/bin:$PATH; cd ${PROJECT_DIR}; cargo test --workspace > /tmp/ne-verify-test.log 2>&1; rc=$?; python3 -c \"import re;t=open('/tmp/ne-verify-test.log',encoding='utf-8',errors='replace').read();print('总通过',sum(int(x) for x in re.findall(r'test result: ok\\\\. (\\\\d+) passed',t)),'失败',sum(int(x) for x in re.findall(r'(\\\\d+) failed',t)))\"; test $rc -eq 0"
      },
      "canvasX": 260.0,
      "canvasY": 300.0,
      "timeoutSeconds": 1800,
      "failurePolicy": "ABORT"
    },
    {
      "id": "release",
      "type": "BASH_COMMAND",
      "title": "③ release 编译",
      "config": {
        "command": "export PATH=/opt/taixu/toolchains/rust/bin:$PATH; cd ${PROJECT_DIR} && cargo build --release -p ne-agent 2>&1 | tail -5"
      },
      "canvasX": 560.0,
      "canvasY": 200.0,
      "timeoutSeconds": 1800,
      "failurePolicy": "ABORT"
    },
    {
      "id": "artifact",
      "type": "BASH_COMMAND",
      "title": "④ 产物体检",
      "config": {
        "command": "cd ${PROJECT_DIR} && BIN=target/release/ne-agent && ls -lh $BIN && $BIN version && echo '--- 动态依赖 ---' && ldd $BIN 2>/dev/null | grep '=>' | awk '{print $1}' && echo '--- 单二进制检查（应仅 libc/libm/libgcc）---' && if ldd $BIN 2>/dev/null | grep '=>' | grep -qvE 'libc|libm|libgcc|ld-linux'; then echo '⚠ 存在额外依赖'; else echo '✓ 仅标准 C 库'; fi"
      },
      "canvasX": 860.0,
      "canvasY": 200.0,
      "failurePolicy": "CONTINUE"
    },
    {
      "id": "done",
      "type": "TERMINAL_OUTPUT",
      "title": "验证完成",
      "config": {},
      "canvasX": 1120.0,
      "canvasY": 200.0
    }
  ],
  "edges": [
    { "id": "e0", "fromNodeId": "start", "fromPort": "success", "toNodeId": "gate", "toPort": "input" },
    { "id": "e1", "fromNodeId": "start", "fromPort": "success", "toNodeId": "test", "toPort": "input" },
    { "id": "e2", "fromNodeId": "gate", "fromPort": "success", "toNodeId": "release", "toPort": "input" },
    { "id": "e3", "fromNodeId": "test", "fromPort": "success", "toNodeId": "release", "toPort": "input" },
    { "id": "e4", "fromNodeId": "release", "fromPort": "success", "toNodeId": "artifact", "toPort": "input" },
    { "id": "e5", "fromNodeId": "artifact", "fromPort": "success", "toNodeId": "done", "toPort": "input" }
  ]
}
