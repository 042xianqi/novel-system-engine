{
  "id": "ne_push",
  "name": "ne-agent · 推送",
  "description": "推送到 origin/<branch>（DNS 修复 + 连通探测 + 3 次重试）。薄壳：只调 workflows/run.sh ne_push，真正逻辑在 workflows/scripts/ne_push.sh。",
  "iconName": "CloudUpload",
  "category": "ne-agent",
  "isBuiltin": false,
  "defaultVariables": {
    "PROJECT_DIR": "/workspace/小说系统",
    "BRANCH": "main"
  },
  "trigger": { "type": "manual", "slashCommand": "/wf ne_push" },
  "nodes": [
    {
      "id": "start",
      "type": "TRIGGER",
      "title": "开始推送",
      "config": {},
      "timeoutSeconds": 30,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 0.0,
      "description": ""
    },
    {
      "id": "run",
      "type": "BASH_COMMAND",
      "title": "run.sh ne_push",
      "config": {
        "command": "cd ${PROJECT_DIR} && BRANCH=${BRANCH} bash workflows/run.sh ne_push"
      },
      "timeoutSeconds": 600,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 120.0,
      "description": "唯一真源：workflows/scripts/ne_push.sh"
    },
    {
      "id": "done",
      "type": "TERMINAL_OUTPUT",
      "title": "推送完成",
      "config": {},
      "timeoutSeconds": 30,
      "failurePolicy": "ABORT",
      "canvasX": 0.0,
      "canvasY": 240.0,
      "description": ""
    }
  ],
  "edges": [
    { "id": "e1", "fromNodeId": "start", "fromPort": "success", "toNodeId": "run", "toPort": "input" },
    { "id": "e2", "fromNodeId": "run", "fromPort": "success", "toNodeId": "done", "toPort": "input" }
  ]
}
