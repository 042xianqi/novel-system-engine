{
  "id": "ne_gate",
  "name": "ne-agent · 架构门禁",
  "description": "跑 architecture-policy 门禁：crate 依赖白名单 + import 黑名单 + 文件行数棘轮。通过则退出码 0。",
  "iconName": "Shield",
  "category": "ne-agent",
  "isBuiltin": false,
  "trigger": { "type": "manual", "slashCommand": "/wf ne_gate" },
  "defaultVariables": {
    "PROJECT_DIR": "/workspace/小说系统"
  },
  "nodes": [
    {
      "id": "start",
      "type": "TRIGGER",
      "title": "开始门禁",
      "config": {},
      "canvasX": 40.0,
      "canvasY": 120.0
    },
    {
      "id": "gate",
      "type": "BASH_COMMAND",
      "title": "arch_check.py",
      "config": {
        "command": "cd ${PROJECT_DIR} && python3 scripts/arch_check.py; rc=$?; echo \"门禁退出码 = $rc\"; exit $rc"
      },
      "canvasX": 300.0,
      "canvasY": 120.0,
      "timeoutSeconds": 300,
      "failurePolicy": "ABORT"
    },
    {
      "id": "done",
      "type": "TERMINAL_OUTPUT",
      "title": "门禁完成",
      "config": {},
      "canvasX": 560.0,
      "canvasY": 120.0
    }
  ],
  "edges": [
    { "id": "e0", "fromNodeId": "start", "fromPort": "success", "toNodeId": "gate", "toPort": "input" },
    { "id": "e1", "fromNodeId": "gate", "fromPort": "success", "toNodeId": "done", "toPort": "input" }
  ]
}
